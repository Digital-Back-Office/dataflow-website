---
interface FaqItem {
  question: string
  answer: string
}

interface Props {
  items: FaqItem[]
  eyebrow?: string
  title?: string
  description?: string
  sectionClass?: string
  containerClass?: string
  leftColumnClass?: string
  rightColumnClass?: string
  cardClass?: string
  summaryClass?: string
  answerClass?: string
}

const {
  items,
  eyebrow = 'FAQ',
  title = 'Questions, answered',
  description = 'Everything you need to know before applying.',
  sectionClass = 'max-w-7xl mx-auto px-[5%] py-16',
  containerClass = 'grid lg:grid-cols-[1.1fr_0.9fr] gap-12 items-start',
  leftColumnClass = 'space-y-5',
  rightColumnClass = 'space-y-4',
  cardClass = 'group rounded-2xl border border-primary/10 bg-white p-5',
  summaryClass = 'flex items-center justify-between cursor-pointer text-lg text-textDarker font-semibold',
  answerClass = 'mt-3 text-md text-textPrimary/80'
} = Astro.props as Props
---

{items?.length > 0 && (
  <section class={sectionClass}>
    <div class={containerClass}>
      <div class={leftColumnClass}>
        {
            eyebrow && <p class='text-sm font-semibold text-primary uppercase tracking-wide'>{eyebrow}</p>
        }
        <h2 class='text-4xl font-bold text-textDarker'>{title}</h2>
        <p class='text-textPrimary/80'>{description}</p>
      </div>
      <div class={rightColumnClass}>
        {items.map((item) => (
          <details class={cardClass}>
            <summary class={summaryClass}>
              {item.question}
              <span class='transition group-open:rotate-45 text-primary text-xl'>+</span>
            </summary>
            <p class={answerClass}>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
)}