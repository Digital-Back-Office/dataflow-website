---
interface FaqItem {
  question: string
  answer: string
}

interface Props {
  faqs: FaqItem[]
  title?: string
  description?: string
  sectionClass?: string
}

const {
  faqs,
  title = 'Frequently Asked Questions',
  description = 'Common questions teams ask before choosing a data platform.',
  sectionClass = 'px-[5%] py-16 md:py-20 bg-slate-50'
} = Astro.props as Props
---

{faqs?.length > 0 && (
  <section class={sectionClass}>
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4" data-aos="fade-up">
          {title}
        </h2>
        <p class="text-lg text-gray-600" data-aos="fade-up" data-aos-delay="100">
          {description}
        </p>
      </div>

      <div class="space-y-4">
        {faqs.map((faq, index) => (
          <details
            class="group rounded-xl border border-slate-200 bg-white p-5 shadow-[0_6px_20px_rgba(2,8,20,0.04)]"
            data-aos="fade-up"
            data-aos-delay={index * 60}
          >
            <summary class="list-none cursor-pointer font-semibold text-gray-900 flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="inline-flex h-7 w-7 items-center justify-center rounded-md bg-slate-100 text-slate-600 group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="mt-3 text-gray-600 leading-relaxed">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
)}
