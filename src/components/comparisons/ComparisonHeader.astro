---
interface Props {
  title: string
  subtitle?: string
}

const { title, subtitle } = Astro.props as Props
---

<section class="px-[5%] py-16 md:py-20 bg-gradient-to-b from-gray-50 to-white">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4" data-aos="fade-up">
        {title}
      </h1>
      {subtitle && (
        <p class="text-lg md:text-xl text-gray-600 max-w-2xl mx-auto" data-aos="fade-up" data-aos-delay="100">
          {subtitle}
        </p>
      )}
    </div>
  </div>
</section>
