---
interface Props {
  title: string
  items: Array<{
    text: string
    isHighlighted: boolean
  }>
}

const { title, items } = Astro.props as Props
---

<section class="px-[5%] py-16 md:py-20 bg-white">
  <div class="max-w-6xl mx-auto">
    <div class="space-y-8">
      <div data-aos="fade-up">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">{title}</h2>
        <div class="flex flex-wrap gap-3">
          {items.map((item) => (
            <div
              class={`px-4 py-2 rounded-full font-medium transition-colors ${
                item.isHighlighted
                  ? 'bg-primary text-white'
                  : 'bg-gray-100 text-gray-700'
              }`}
            >
              {item.text}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
