---
interface FAQContentType {
  heading: string
  faqs: Array<{
    question: string
    answer: string
  }>
}
import * as FAQContent from '../../content/pricing/faq.mdx'
import FaqSection from '../common/FaqSection.astro'
const faqContent = FAQContent as unknown as FAQContentType

const heading = faqContent.heading
const faqs = faqContent.faqs
---

<FaqSection
  items={faqs}
  eyebrow='FAQ'
  title='Questions, answered'
  description={heading}
  sectionClass='max-w-7xl mx-auto px-[5%] py-16'
/>
