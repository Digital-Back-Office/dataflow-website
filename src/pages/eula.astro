---
import Layout from '../layouts/Layout.astro'
import { Content } from './_eula.md'
---

<Layout
  title='End User License Agreement | Dataflow AI-Ready Data Platform'
  meta_description='Read the Dataflow End User License Agreement (EULA) covering license terms and acceptable use of the platform.'
>
  <section class='min-h-screen bg-white px-[5%] pt-36 pb-20 max-sm:pt-28 max-sm:pb-12'>
    <div class='max-w-3xl mx-auto'>
      <div class='mb-10 pb-6 border-b border-gray-200'>
        <p class='text-xs font-semibold tracking-[0.15em] text-primary uppercase mb-2'>Legal</p>
        <h1 class='text-[28px] max-sm:text-2xl font-bold text-gray-900 leading-tight'>
          End User License Agreement
        </h1>
      </div>

      <div class='prose prose-slate max-w-none text-[15px] leading-relaxed prose-headings:font-semibold prose-headings:text-gray-900 prose-h2:text-xl prose-h2:mt-9 prose-h2:mb-3 prose-h2:pb-2 prose-h2:border-b prose-h2:border-gray-100 prose-h3:text-base prose-h3:mt-6 prose-h3:mb-2 prose-p:my-3 prose-p:text-gray-700 prose-p:leading-relaxed prose-li:my-1 prose-li:text-gray-700 prose-ul:my-3 prose-strong:text-gray-900 prose-strong:font-semibold prose-a:text-primary prose-a:no-underline prose-a:font-medium hover:prose-a:underline'>
        <Content />
      </div>
    </div>
  </section>
</Layout>
