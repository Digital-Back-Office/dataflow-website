---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import SocialIcon, { type Platform } from '../../components/common/SocialIcon.astro'

export async function getStaticPaths() {
  const pressReleases = await getCollection('press')
  const paths = pressReleases.map((release: any) => {
    return {
      params: {
        title: release.slug
      },
      props: release
    }
  })
  return paths
}

const { data, body, render } = Astro.props
const { title, date, location, tags, image, description } = data
const meta_description = description ?? `Read the press release: ${title} from Dataflow.`
const { Content } = await Astro.props.render()

// Extract headings from markdown body for TOC
const headings: Array<{ depth: number; text: string; slug: string }> = []
const headingRegex = /^(#{2,3})\s+([^#\n]+)$/gm
let match
while ((match = headingRegex.exec(body)) !== null) {
  const depth = match[1].length
  const text = match[2].trim()
  const cleanText = text
    .replace(/\*\*(.+?)\*\*/g, '$1')
    .replace(/\*(.+?)\*/g, '$1')
    .replace(/\[(.+?)\]\(.+?\)/g, '$1')
    .replace(/`(.+?)`/g, '$1')
    .trim()
  const slug = cleanText
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '')
  headings.push({ depth, text: cleanText, slug }) 
}

// Get other announcements
const allPress = await getCollection('press')
const otherPress = allPress
  .filter((p) => p.slug !== Astro.props.slug)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3)

const siteOrigin = (Astro.site?.toString() ?? "https://dataflow.zone").replace(/\/$/, "");
const ogImage = image ? new URL(image, `${siteOrigin}/`).toString() : undefined;
const normalizedPath = Astro.url.pathname === '/' ? '/' : `${Astro.url.pathname.replace(/\/+$/, '')}/`;
const articleUrl = new URL(normalizedPath, `${siteOrigin}/`).toString();
const fallbackOgImage = new URL('/og-image.png', `${siteOrigin}/`).toString();
const encodedArticleUrl = encodeURIComponent(articleUrl);
const encodedTitle = encodeURIComponent(title);

type ShareLink = {
  icon: Platform;
  label: string;
  href: string;
};

const shareLinks: ShareLink[] = [
  {
    icon: 'x',
    label: 'X',
    href: `https://twitter.com/intent/tweet?url=${encodedArticleUrl}&text=${encodedTitle}`,
  },
  {
    icon: 'linkedin',
    label: 'LinkedIn',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedArticleUrl}`,
  },
  {
    icon: 'email',
    label: 'Email',
    href: `mailto:?subject=${encodedTitle}&body=${encodedArticleUrl}`,
  },
];

const pageSchema = [
  {
    "@type": "NewsArticle",
    "@id": `${articleUrl}#newsarticle`,
    isPartOf: {
      "@id": `${siteOrigin}#website`,
    },
    headline: title,
    description: meta_description,
    datePublished: new Date(date).toISOString(),
    dateModified: new Date(date).toISOString(),
    image: ogImage ? [ogImage] : [fallbackOgImage],
    publisher: {
      "@id": `${siteOrigin}#organization`,
    },
    inLanguage: "en",
    url: articleUrl,
    dateline: `${location} — ${date}`
  }
];
---

<Layout
  title={`${title} | Dataflow Press`}
  meta_description={meta_description}
  ogImage={ogImage}
  pageSchema={pageSchema}
>
  <!-- Hero / Header Section -->
  <section class='relative overflow-hidden px-[10%] max-sm:px-[20px] pt-[10%] pb-[40px] max-sm:pb-[30px]'>
    <div class='absolute inset-0 -z-10 bg-gradient-to-b from-primary/5 via-white to-white'></div>
    <div class='max-w-full mx-auto'>
      <!-- Breadcrumb -->
      <nav class='mb-6' aria-label='breadcrumb' data-aos='fade-up' data-aos-duration='800'>
        <ol class='flex items-center space-x-2 text-sm text-gray-600'>
          <li>
            <a href='/press' class='hover:text-primary transition-colors' title='Back to pressroom'>Pressroom</a>
          </li>
          <li class='text-gray-400'>/</li>
          <li class='text-textblack font-medium line-clamp-1' aria-current='page'>
            {title}
          </li>
        </ol>
      </nav>

      <span class='px-3 py-1 bg-primary/10 text-primary rounded-full text-xs font-semibold uppercase tracking-wider mb-4 inline-block' data-aos='fade-up' data-aos-delay='100'>
        Press Release
      </span>

      <h1 class='display-4 mb-[24px] text-4xl md:text-5xl font-bold max-w-5xl text-textblack' style='line-height: 1.12;' data-aos='fade-up' data-aos-delay='200'>
        {title}
      </h1>

      <div class='flex flex-wrap items-center gap-3 mb-4' data-aos='fade-up' data-aos-delay='250'>
        <span class='text-sm font-semibold text-textblack'>{location}</span>
        <span class='text-gray-300'>|</span>
        <time datetime={date} class='text-sm text-gray-600'>{date}</time>
        {tags && tags.length > 0 && (
          <>
            <span class='text-gray-300'>|</span>
            <div class='flex flex-wrap gap-2'>
              {tags.map((tag: string) => (
                <span class='px-2.5 py-1 bg-primary/5 text-primary rounded-full text-xs font-medium border border-primary/10'>
                  {tag}
                </span>
              ))}
            </div>
          </>
        )}
      </div>
    </div>
  </section>

  <!-- Main Content - Two Column Layout -->
  <section class='px-[10%] max-sm:px-[20px] pb-[140px] max-sm:pb-[80px]'>
    <div class='max-w-[1400px] mx-auto'>
      <div class='flex flex-col lg:flex-row gap-12 items-start'>
        
        <!-- Left Column: Press Release Content -->
        <div class='flex-1 w-full lg:max-w-[calc(100%-400px)]'>
          <!-- Cover Image -->
          {
            image && (
              <figure class='overflow-hidden rounded-2xl shadow-sm mb-8 border border-gray-100' data-aos='fade-up' data-aos-delay='150'>
                <img
                  src={image}
                  alt={`${title} cover image`}
                  loading='eager'
                  fetchpriority='high'
                  class='w-full min-h-[300px] max-h-[480px] object-cover'
                />
              </figure>
            )
          }
          
          <div class='bg-white/90 backdrop-blur rounded-2xl shadow-sm border border-gray-100 p-8 md:p-12' data-aos='fade-up' data-aos-delay='200'>
            <div id='press-content' class='prose w-full max-w-none md:prose-img:max-w-[70%] prose-img:mx-auto prose-img:rounded-xl prose-headings:scroll-mt-24 prose-h2:mt-10 prose-h3:mt-8 prose-p:leading-relaxed prose-blockquote:border-primary/80 prose-li:marker:text-primary/80 prose-ol:marker:text-primary/80 prose-ul:marker:text-primary/80'>
              <Content />
            </div>
          </div>

          <!-- Sharing Block -->
          <div class='mt-8 rounded-2xl border border-gray-100 bg-white p-6 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4' data-aos='fade-up' data-aos-delay='220'>
            <div class='text-left'>
              <h3 class='text-sm uppercase tracking-wide text-gray-500 font-semibold mb-1'>Share this announcement</h3>
              <p class='text-xs text-gray-600'>Spread the news with your network.</p>
            </div>
            <div class='flex flex-wrap gap-2'>
              {shareLinks.map((share) => (
                <a
                  href={share.href}
                  target='_blank'
                  rel='noopener noreferrer'
                  class='inline-flex items-center gap-2 rounded-full border border-gray-200 px-4 py-2 text-xs font-semibold text-gray-700 hover:text-primary hover:border-primary/40 transition-colors'
                  title={`Share on ${share.label}`}
                >
                  <SocialIcon platform={share.icon} className='w-4 h-4' />
                  <span>{share.label}</span>
                </a>
              ))}
              <button
                type='button'
                id='copy-link-btn'
                class='inline-flex items-center gap-2 rounded-full border border-gray-200 px-4 py-2 text-xs font-semibold text-gray-700 hover:text-primary hover:border-primary/40 transition-colors'
                data-copy-url={articleUrl}
                aria-label='Copy article link'
              >
                <SocialIcon platform='copy' className='w-4 h-4' />
                <span>Copy Link</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Right Column: Sticky Sidebar -->
        <aside class='w-full lg:w-[360px] space-y-6 flex-shrink-0' data-aos='fade-up' data-aos-delay='250'>
          
          <!-- Table of Contents -->
          {headings.length > 0 && (
            <div id='toc-container' class='bg-white rounded-xl shadow-sm border border-gray-100 p-6 max-sm:hidden'>
              <h3 class='text-base font-bold text-textblack mb-4'>
                Table of contents
              </h3>
              <nav id='toc-nav' class='space-y-1'>
                {headings.map((heading) => (
                  <a
                    href={`#${heading.slug}`}
                    data-level={heading.depth}
                    title={heading.text}
                    class='toc-link'
                  >
                    {heading.text}
                  </a>
                ))}
              </nav>
            </div>
          )}

          <!-- Media Contacts Card -->
          <div class='bg-gradient-to-br from-primary/10 to-primary/5 rounded-xl p-6 border border-primary/20 shadow-sm'>
            <h3 class='text-lg font-bold text-textblack mb-2'>Media Contacts</h3>
            <p class='text-sm text-gray-600 mb-4'>For inquiries, media requests, or interviews, please contact:</p>
            <div class='space-y-3'>
              <div class='flex items-start gap-3'>
                <svg class='w-5 h-5 text-primary mt-0.5 flex-shrink-0' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                  <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z'></path>
                </svg>
                <div>
                  <h4 class='text-xs uppercase tracking-wider text-gray-500 font-semibold'>Dataflow Press</h4>
                  <a href='mailto:press@dataflow.zone' class='text-sm text-primary hover:underline font-medium'>press@dataflow.zone</a>
                </div>
              </div>
              <div class='flex items-start gap-3 pt-2 border-t border-gray-100'>
                <svg class='w-5 h-5 text-primary mt-0.5 flex-shrink-0' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                  <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z'></path>
                </svg>
                <div>
                  <h4 class='text-xs uppercase tracking-wider text-gray-500 font-semibold'>IONOS Communications</h4>
                  <a href='mailto:communications@ionos.com' class='text-sm text-primary hover:underline font-medium'>communications@ionos.com</a>
                </div>
              </div>
            </div>
          </div>

          <!-- Other Press Releases -->
          {otherPress.length > 0 && (
            <div class='bg-white rounded-xl shadow-sm border border-gray-100 p-6'>
              <h3 class='text-base font-bold text-textblack mb-4'>
                Other Announcements
              </h3>
              <div class='space-y-4'>
                {otherPress.map((press) => (
                  <a href={`/press/${press.slug}`} class='group block' title={press.data.title}>
                    <div class='flex gap-3'>
                      {press.data.image && (
                        <img 
                          src={press.data.image} 
                          alt={press.data.title}
                          loading='lazy'
                          class='w-16 h-16 object-cover rounded-lg flex-shrink-0'
                        />
                      )}
                      <div class='flex-1 min-w-0'>
                        <h4 class='text-xs font-semibold text-textblack group-hover:text-primary transition-colors line-clamp-2 mb-1'>
                          {press.data.title}
                        </h4>
                        <span class='text-[10px] uppercase font-bold text-gray-400'>{press.data.location}</span>
                        <span class='text-gray-300 mx-1'>•</span>
                        <time class='text-[10px] text-gray-500'>{press.data.date}</time>
                      </div>
                    </div>
                  </a>
                ))}
              </div>
              <a 
                href='/press' 
                title='View all press releases'
                class='mt-4 pt-4 border-t border-gray-200 text-sm font-semibold text-primary hover:text-primary/80 transition-colors flex items-center gap-1 group'
              >
                View all announcements
                <svg class='w-4 h-4 group-hover:translate-x-1 transition-transform' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                  <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M9 5l7 7-7 7'></path>
                </svg>
              </a>
            </div>
          )}

        </aside>

      </div>
    </div>
  </section>
</Layout>

<style>
  /* Responsive iframe styling */
  :global(#press-content iframe) {
    width: 100% !important;
    max-width: 100% !important;
    height: auto !important;
    aspect-ratio: 16/9;
    display: block;
    border: 0;
    border-radius: 0.5rem;
  }

  /* Smooth scroll behavior */
  html {
    scroll-behavior: smooth;
  }

  /* Sticky sidebar */
  @media (min-width: 1024px) {
    aside {
      position: sticky;
      top: 7rem;
      align-self: flex-start;
    }
  }

  /* TOC Links */
  #toc-nav a {
    display: block;
    padding: 0.375rem 0;
    color: #6b7280;
    text-decoration: none;
    font-size: 0.875rem;
    line-height: 1.5;
    transition: all 0.2s;
    position: relative;
    border-left: 2px solid transparent;
    padding-left: 0.75rem;
  }

  #toc-nav a:hover {
    color: #30BABA;
  }

  #toc-nav a.active {
    color: #30BABA;
    font-weight: 600;
    border-left-color: #30BABA;
  }

  #toc-nav a[data-level="2"] {
    font-size: 0.875rem;
    font-weight: 500;
    color: #374151;
    margin-top: 0.5rem;
  }

  #toc-nav a[data-level="2"]:first-child {
    margin-top: 0;
  }

  #toc-nav a[data-level="2"]:hover {
    color: #30BABA;
  }

  #toc-nav a[data-level="2"].active {
    font-weight: 600;
  }

  #toc-nav a[data-level="3"] {
    padding-left: 1.5rem;
    font-size: 0.8125rem;
    color: #9ca3af;
    font-weight: 400;
    margin-top: 0.125rem;
  }

  #toc-nav a[data-level="3"]:hover,
  #toc-nav a[data-level="3"].active {
    color: #30BABA;
  }

  #toc-nav a[data-level="3"].active {
    font-weight: 500;
  }

  @media (max-width: 1023px) {
    aside {
      position: static;
    }
  }

  /* Prevent table overflow */
  :global(#press-content table) {
    display: block;
    width: 100%;
    min-width: 100%;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    font-size: 1rem;
  }

  :global(#press-content th),
  :global(#press-content td) {
    white-space: nowrap;
  }
</style>

<script is:inline>
  // Copy Link functionality
  document.addEventListener('DOMContentLoaded', function() {
    const copyLinkButton = document.getElementById('copy-link-btn');
    if (!copyLinkButton) return;

    const originalText = copyLinkButton.innerHTML;

    copyLinkButton.addEventListener('click', async function() {
      const linkToCopy = copyLinkButton.getAttribute('data-copy-url') || window.location.href;

      try {
        await navigator.clipboard.writeText(linkToCopy);
        copyLinkButton.innerHTML = `
        <svg class='h-4 w-4 text-primary' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
          <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M5 13l4 4L19 7'></path>
        </svg>
        <span>Copied</span>
        `;
      } catch (error) {
        const tempInput = document.createElement('input');
        tempInput.value = linkToCopy;
        document.body.appendChild(tempInput);
        tempInput.select();
        document.execCommand('copy');
        document.body.removeChild(tempInput);
        copyLinkButton.innerHTML = `<span>Copied</span>`;
      }

      window.setTimeout(function() {
        copyLinkButton.innerHTML = originalText;
      }, 3000);
    });
  });
</script>

<script is:inline>
  // Table of Contents Scroll Highlighting
  document.addEventListener('DOMContentLoaded', function() {
    const content = document.getElementById('press-content');
    const tocNav = document.getElementById('toc-nav');
    
    if (!content || !tocNav) return;

    const headings = content.querySelectorAll('h2, h3');
    if (headings.length === 0) return;

    function generateSlug(text) {
      return text
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
    }

    headings.forEach((heading) => {
      if (!heading.id) {
        heading.id = generateSlug(heading.textContent);
      }
    });

    const tocLinks = tocNav.querySelectorAll('a');
    tocLinks.forEach((link) => {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        const targetId = this.getAttribute('href').substring(1);
        const target = document.getElementById(targetId);
        
        if (target) {
          const offset = 100;
          const targetPosition = target.getBoundingClientRect().top + window.pageYOffset - offset;
          window.scrollTo({
            top: targetPosition,
            behavior: 'smooth'
          });
        }
      });
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const id = entry.target.id;
          const link = tocNav.querySelector(`a[href="#${id}"]`);
          
          if (entry.isIntersecting && link) {
            tocNav.querySelectorAll('a').forEach(a => a.classList.remove('active'));
            link.classList.add('active');
          }
        });
      },
      {
        rootMargin: '-100px 0px -66%',
        threshold: 0
      }
    );

    headings.forEach((heading) => {
      observer.observe(heading);
    });
  });
</script>
